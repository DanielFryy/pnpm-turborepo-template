{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#check-format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#format"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#check-format": {},
    "//#format": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@repo/oxlint-config#test": {
      "cache": false
    }
  }
}
