{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-format": "prettier -c ./**/*.{js,ts,tsx,json,css,md}",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "update-dependencies": "ncu -l silent -u -ws && pnpm run clean && pnpm i",
    "clean": "rm -rf node_modules **/**/node_modules **/**/.next **/**/.turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=18"
  }
}
