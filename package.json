{
  "name": "my-turborepo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix --max-warnings 0",
    "check-format": "oxfmt --check \"**/*.{js,ts,tsx,json,css,md}\"",
    "format": "oxfmt --write \"**/*.{js,ts,tsx,json,css,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:lint-config": "pnpm --filter @repo/oxlint-config test",
    "update-dependencies": "ncu -l silent -u -ws && pnpm run clean && pnpm i",
    "clean": "rm -rf node_modules **/**/node_modules **/**/.next **/**/.turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
